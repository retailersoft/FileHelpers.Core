<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0</TargetFrameworks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FileHelpers.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    
    <!-- Updated for RetailerSoft fork -->
    <PackageId>RetailerSoft.FileHelpers.Core</PackageId>
    <Version>9.0.4</Version>
    <Description>FileHelpers.Core fork for .NET 9 - Open Source library for automatic formatted file read/write operations. Fork maintained by RetailerSoft.</Description>
    <Company>RetailerSoft</Company>
    <Product>FileHelpers.Core (RetailerSoft Fork)</Product>
    <Copyright>Original: Marcos Meli - Devoo | Fork: RetailerSoft</Copyright>
    <Authors>Marcos Meli, Contributors, and RetailerSoft</Authors>
    <Owners>RetailerSoft</Owners>
    
    <!-- License and URLs -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/retailersoft/FileHelpers.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/retailersoft/FileHelpers.Core.git</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageReleaseNotes>Fork of FileHelpers targeting .NET 9. See https://github.com/retailersoft/FileHelpers.Core for details. Original project: www.filehelpers.net/changelog</PackageReleaseNotes>
    <PackageTags>FileHelpers;Data;Flat File;CSV;FixedLength;Fixed;Delimited;Import;Export;ETL;FileHelper;.NET;.NET Core;.NET 9;RetailerSoft</PackageTags>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.8" />
  </ItemGroup>
</Project>
