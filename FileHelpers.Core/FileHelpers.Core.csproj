<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FileHelpers.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <Version>10.0.0</Version>
    <Description>Open Source library for automatic formatted file read/write operations. This is a .NET 10 fork maintained by RetailerSoft.</Description>
    <Company>RetailerSoft</Company>
    <Product>FileHelpers.Core</Product>
    <Copyright>Original: Marcos Meli - Devoo | Fork: RetailerSoft</Copyright>
    <Authors>Marcos Meli, Contributors, and RetailerSoft</Authors>
    <Owners>RetailerSoft</Owners>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/retailersoft/FileHelpers.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/retailersoft/FileHelpers.Core.git</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageReleaseNotes>.NET 10 fork with README. Removed obsolete DataLink/Storage classes. Original: www.filehelpers.net/changelog</PackageReleaseNotes>
    <PackageTags>FileHelpers;Data;Flat File;CSV;FixedLength;Fixed;Delimited;Import;Export;ETL;FileHelper;.NET;.NET Core;.NET 10</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    
    <!-- Include README in package -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  
  <!-- Include README file -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
  </ItemGroup>
</Project>
